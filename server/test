app.post("/theses/:thesisId/factors", authenticate, async (req, res) => {
  try {
    const { thesisId } = req.params;
    console.log(thesisId);
    // بررسی نقش کاربر
    if (!req.user.roles.includes('عضو هیات علمی')) {
      return res.status(403).send('شما مجوز ثبت هزینه را ندارید');
    }

    // بررسی اینکه استاد راهنمای این پایان‌نامه هست یا نه
    const pool = await sql.connect(config);
    const checkResult = await pool.request()
      .input('thesisId', sql.Int, thesisId)
      .input('professorId', sql.NVarChar, req.user.nationalCode)
      .query(`
        SELECT 1 
        FROM professors_students 
        WHERE ThesisID = @thesisId AND professornationalcode = @professorId
      `);
    
    if (checkResult.recordset.length === 0) {
      return res.status(403).send('شما استاد راهنمای این پایان‌نامه نیستید');
    }

    if (!req.file) {
      return res.status(400).send('فایل فاکتور الزامی است');
    }

    const { factorNumber, factorDate, amount, description } = req.body;
    const filePath = `/uploads/factors/${Date.now()}_${req.file.originalname}`;

    // ذخیره فایل در سیستم
    const fs = require('fs');
    fs.writeFileSync(`.${filePath}`, req.file.buffer);

    // ذخیره اطلاعات در دیتابیس
    await pool.request()
      .input('thesisId', sql.Int, thesisId)
      .input('factorNumber', sql.NVarChar, factorNumber)
      .input('factorDate', sql.NVarChar, factorDate)
      .input('amount', sql.Decimal, amount)
      .input('description', sql.NVarChar, description)
      .input('filePath', sql.NVarChar, filePath)
      .query(`
        INSERT INTO factors 
        (ThesisID, FactorNumber, FactorDate, Amount, Description, Filepath)
        VALUES 
        (@thesisId, @factorNumber, @factorDate, @amount, @description, @filePath)
      `);

    res.status(201).send('فاکتور با موفقیت ثبت شد');
  } catch (err) {
    console.error("Error saving factor:", err);
    res.status(500).send(err.message);
  }
});




